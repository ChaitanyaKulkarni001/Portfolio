---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import AssignmentPreview from "../components/AssignmentPreview.astro";
import Assignmentachievements from "../components/Assignmentachievement.astro";
// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
const honors = (await getCollection("honor"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow">&gt; agentic_ai_developer</p>
          <Hero
            title="Hi, I'm Chaitanya."
            tagline="Agentic AI Developer building autonomous AI agents and multi-agent systems with LangGraph and AWS Strands Agents."
            align="start"
          >
            <div class="roles">
              <Pill><Icon icon="rocket-launch" size="1.33em" /> Agentic AI Developer</Pill>
              <Pill><Icon icon="terminal-window" size="1.33em" /> LangGraph &amp; Multi-Agent Systems</Pill>
              <Pill><Icon icon="code" size="1.33em" /> AWS Certified Solutions Architect</Pill>
            </div>
          </Hero>
        </div>

        <div class="hero-photo">
          <img
            alt="Chaitanya Kulkarni"
            width="1280"
            height="960"
            src="/assets/home-hero.png"
          />
        </div>
      </header>

      <!-- <div class="cta"> -->
      <div class="Middle">
        <!-- This is My Main Resume -->
        <!-- <CallToAction 	target='_blank' href="https://drive.google.com/file/d/1q_p_btShdFgYeKnhRwAn-f0wuWb3REeh/view?usp=sharing"> -->
        <!-- This one is for PTC -->
        <CallToAction
          target="_blank"
          href="https://drive.google.com/file/d/1XqkiR53_cf2BkY6kkJ4D54VXLoGkRdNU/view?usp=sharing"
        >
          Resume
          <Icon icon="arrow-right" size="1.2em" />
        </CallToAction>
      </div>
      <!-- </div> -->

      <!-- <a class="resume-button" href="https://drive.google.com/file/d/1ayiXyIENrc2TRcfRV-VpO-iIlzPz4jtd/view?usp=sharing" target="_blank" rel="noopener noreferrer">
				<Pill class="pill">
					<span  class="resume-icon">

						<Icon  icon="star" size="1.5em" />
					</span>
					<span class="resume-text"> Resume</span>
				</Pill>
			</a> -->

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <!-- EXPERIENCE SECTION -->
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Experience</h3>
          <p>My latest professional and internship experiences.</p>
        </header>

        <div class="gallery">
          <ul class="experience-list">
            <li class="experience-card" data-experience="dataphi">
              <div class="experience-box">
                <div class="experience-box__logo">
                  <img
                    src="/assets/dataphi-logo.jpg"
                    alt="DataPhi Logo"
                    class="experience-logo"
                  />
                </div>

                <div class="experience-box__content">
                  <h4 class="experience-title">
                    Agentic AI Developer <span class="experience-company"
                      >| DataPhi (PhAI — AI Vertical)</span>
                  </h4>
                  <p class="experience-date">
                    <strong>Sept 2025 – Present</strong>
                  </p>
                  <p class="experience-desc">Architecting autonomous AI agents &amp; multi-agent systems for live client deployments.</p>
                  <p class="experience-more">View details <Icon icon="arrow-right" size="0.9em" /></p>
                </div>
              </div>
            </li>
            <li class="experience-card" data-experience="rezoomex">
              <div class="experience-box">
                <div class="experience-box__logo">
                  <img
                    src="/assets/rezoomex_logo.jpeg"
                    alt="Rezoomex Logo"
                    class="experience-logo"
                  />
                </div>

                <div class="experience-box__content">
                  <h4 class="experience-title">
                    Trainee – Developer <span class="experience-company"
                      >| Rezoomex (Remote)</span>
                  </h4>
                  <p class="experience-date">
                    <strong>Aug 2025 – Sept 2025</strong>
                  </p>
                  <p class="experience-desc">Hands-on with version control, debugging, and agile feature development.</p>
                  <p class="experience-more">View details <Icon icon="arrow-right" size="0.9em" /></p>
                </div>
              </div>
            </li>
          </ul>
        </div>

        <!-- Experience Modal -->
        <div id="experienceModal" class="experience-modal">
          <div class="experience-modal__content">
            <button class="experience-modal__close" id="closeModalBtn">✕</button>
            
            <div class="experience-modal__header">
              <img id="modalLogo" src="" alt="" class="experience-modal__logo" />
              <div>
                <h2 id="modalTitle"></h2>
                <p id="modalCompany" class="experience-modal__company"></p>
              </div>
            </div>

            <div class="experience-modal__body">
              <p id="modalDate" class="experience-modal__date"></p>
              <p id="modalSummary" class="experience-modal__summary"></p>
              <ul id="modalHighlights" class="experience-modal__highlights"></ul>
            </div>
          </div>
        </div>

        <script define:vars={{}} type="module">
          const experienceData = {
            dataphi: {
              title: "Agentic AI Developer",
              company: "DataPhi (PhAI — AI Vertical)",
              date: "Sept 2025 – Present",
              logo: "/assets/dataphi-logo.jpg",
              summary: "Architecting and deploying autonomous AI agents and multi-agent systems for live client engagements, owning architecture decisions across AWS and Azure.",
              highlights: [
                "Architect autonomous AI agents and multi-agent systems using AWS Strands Agents, deployed for live client engagements.",
                "Built a Semantic Model Conversational AI system for natural-language interaction over structured semantic data models.",
                "Developed an AI-enabled search mechanism using semantic/vector search across large, unstructured client datasets.",
                "Built an HR Bot for policy queries and leave management, integrated directly into Microsoft Teams.",
                "Designed a Multi-Agent Orchestrator coordinating specialized agents across complex, multi-step workflows.",
                "Work directly with clients to translate business requirements into technical agent architectures."
              ]
            },
            rezoomex: {
              title: "Trainee – Developer",
              company: "Rezoomex, Remote",
              date: "Aug 2025 – Sept 2025",
              logo: "/assets/rezoomex_logo.jpeg",
              summary: "Hands-on with version control, debugging, and agile feature development, owning individual modules end-to-end.",
              highlights: [
                "Worked within an agile team to ship features from planning through code review.",
                "Debugged and maintained production code, building fluency with real-world version control workflows."
              ]
            }
          };

          function openExperienceModal(experienceKey) {
            const data = experienceData[experienceKey];

            if (!data) return;

            const modal = document.getElementById('experienceModal');
            const modalLogo = document.getElementById('modalLogo');
            const modalTitle = document.getElementById('modalTitle');
            const modalCompany = document.getElementById('modalCompany');
            const modalDate = document.getElementById('modalDate');
            const modalSummary = document.getElementById('modalSummary');
            const modalHighlights = document.getElementById('modalHighlights');

            modalLogo.src = data.logo;
            modalLogo.alt = data.company;
            modalTitle.textContent = data.title;
            modalCompany.textContent = data.company;
            modalDate.textContent = data.date;
            modalSummary.textContent = data.summary;

            modalHighlights.innerHTML = '';
            data.highlights.forEach((point) => {
              const li = document.createElement('li');
              li.textContent = point;
              modalHighlights.appendChild(li);
            });

            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
          }

          function closeExperienceModal() {
            const modal = document.getElementById('experienceModal');
            modal.classList.remove('active');
            document.body.style.overflow = 'auto';
          }

          // Event listeners
          const experienceBoxes = document.querySelectorAll('.experience-box');
          experienceBoxes.forEach(box => {
            box.addEventListener('click', (e) => {
              e.stopPropagation();
              const card = box.closest('[data-experience]');
              const experienceKey = card.getAttribute('data-experience');
              openExperienceModal(experienceKey);
            });
          });

          // Close button
          const closeBtn = document.getElementById('closeModalBtn');
          if (closeBtn) {
            closeBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              closeExperienceModal();
            });
          }

          // Close on modal backdrop click
          const modal = document.getElementById('experienceModal');
          modal.addEventListener('click', (e) => {
            if (e.target === modal) {
              closeExperienceModal();
            }
          });

          // Close on Escape key
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              closeExperienceModal();
            }
          });
        </script>
      </section>
      <!-- END EXPERIENCE SECTION -->

      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Projects</h3>
          <p>Take a look below at some of my featured projects.</p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <main class="wrapper stack gap-20 lg:gap-48">
        <section class="section with-background with-cta">
          <header class="section-header stack gap-2 lg:gap-4">
            <h3>Achievements & Certificates</h3>
            <p>Take a look below at some of my featured achievements.</p>
          </header>

          <div class="gallery">
            <Grid variant="offset">
              {
                honors.map((achievement) => (
                  <li>
                    <AssignmentPreview achievement={achievement} />
                    {/* <Assignmentachievements 
                title={achievement.title} 
                img={achievement.img} 
                img_alt={achievement.img_alt} 
                description={achievement.description} 
                slug={achievement.slug} 
            /> */}
                  </li>
                ))
              }
            </Grid>
          </div>

          <div class="cta">
            <CallToAction href="/honor/">
              View All
              <Icon icon="arrow-right" size="1.2em" />
            </CallToAction>
          </div>
        </section>

        <section class="tech-stack">
          <header class="section-header stack gap-2 lg:gap-4">
            <p class="eyebrow">&gt; tech_stack</p>
            <h3>Tools &amp; Frameworks</h3>
            <p>The agentic AI stack I build with day to day, plus the cloud and dev tooling around it.</p>
          </header>

          <div class="ai-badges">
            <span class="ai-badge">LangChain</span>
            <span class="ai-badge">LangGraph</span>
            <span class="ai-badge">LangSmith</span>
            <span class="ai-badge">AWS Strands Agents</span>
            <span class="ai-badge">AWS Bedrock</span>
            <span class="ai-badge">RAG</span>
            <span class="ai-badge">Prompt Engineering</span>
            <span class="ai-badge">Azure AI Fundamentals</span>
          </div>

          <div class="skills-marquee">
            <div class="skills-marquee__track">
              <!-- First pass of icons -->
              <img src="https://skillicons.dev/icons?i=aws" alt="AWS" title="AWS" />
              <img src="https://skillicons.dev/icons?i=azure" alt="Azure" title="Azure" />
              <img src="https://skillicons.dev/icons?i=python" alt="Python" title="Python" />
              <img src="https://skillicons.dev/icons?i=django" alt="Django" title="Django" />
              <img src="https://skillicons.dev/icons?i=react" alt="React" title="React" />
              <img src="https://skillicons.dev/icons?i=tailwind" alt="Tailwind CSS" title="Tailwind CSS" />
              <img src="https://skillicons.dev/icons?i=postgres" alt="PostgreSQL" title="PostgreSQL" />
              <img src="https://skillicons.dev/icons?i=linux" alt="Linux" title="Linux" />
              <img src="https://skillicons.dev/icons?i=git" alt="Git" title="Git" />
              <img src="https://skillicons.dev/icons?i=github" alt="GitHub" title="GitHub" />

              <!-- Duplicate for seamless loop -->
              <img src="https://skillicons.dev/icons?i=aws" alt="AWS" title="AWS" />
              <img src="https://skillicons.dev/icons?i=azure" alt="Azure" title="Azure" />
              <img src="https://skillicons.dev/icons?i=python" alt="Python" title="Python" />
              <img src="https://skillicons.dev/icons?i=django" alt="Django" title="Django" />
              <img src="https://skillicons.dev/icons?i=react" alt="React" title="React" />
              <img src="https://skillicons.dev/icons?i=tailwind" alt="Tailwind CSS" title="Tailwind CSS" />
              <img src="https://skillicons.dev/icons?i=postgres" alt="PostgreSQL" title="PostgreSQL" />
              <img src="https://skillicons.dev/icons?i=linux" alt="Linux" title="Linux" />
              <img src="https://skillicons.dev/icons?i=git" alt="Git" title="Git" />
              <img src="https://skillicons.dev/icons?i=github" alt="GitHub" title="GitHub" />
            </div>
          </div>
        </section>

        <style>
          .tech-stack {
            position: relative;
            overflow: hidden;
            padding-top: 2rem;
            padding-bottom: 2rem;
          }

          .tech-stack .section-header {
            margin-inline: auto;
          }

          .tech-stack .eyebrow {
            font-family: 'JetBrains Mono', 'Fira Code', var(--font-brand);
            font-size: var(--text-sm);
            letter-spacing: 0.05em;
            color: var(--accent-tech-1);
            background: var(--accent-tech-soft-bg);
            border: 1px solid var(--accent-tech-soft-border);
            border-radius: 999px;
            padding: 0.35rem 1rem;
            width: fit-content;
            margin-inline: auto;
          }

          .ai-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: center;
            margin: 2.5rem 0;
          }

          .ai-badge {
            font-family: 'JetBrains Mono', 'Fira Code', var(--font-brand);
            font-size: var(--text-sm);
            font-weight: 500;
            color: var(--gray-100);
            padding: 0.55rem 1.25rem;
            border-radius: 999px;
            border: 1px solid transparent;
            background:
              linear-gradient(var(--gray-999), var(--gray-999)) padding-box,
              linear-gradient(120deg, var(--accent-tech-1), var(--accent-tech-2)) border-box;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
          }

          .ai-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25);
          }

          .skills-marquee {
            overflow: hidden;
            /* height accommodates icons + a bit of padding */
            height: 8rem;
            position: relative;
          }

          .skills-marquee__track {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            /* animate from 0 → -50% */
            animation: marquee-left 25s linear infinite;
          }

          .skills-marquee__track img {
            width: 5rem;
            height: 5rem;
            object-fit: contain;
            filter: grayscale(0.4);
            transition:
              filter 0.2s ease,
              transform 0.2s ease;
          }

          .skills-marquee__track img:hover {
            filter: none;
            transform: scale(1.15);
          }

          @keyframes marquee-left {
            0% {
              transform: translateX(0);
            }
            100% {
              transform: translateX(-50%);
            }
          }

          .tech-stack .section-header p {
            color: var(--gray-300);
            font-size: var(--text-md);
          }
        </style>
      </main>

      <ContactCTA />
    </main>
  </div>

  <style>
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .eyebrow {
      font-family: 'JetBrains Mono', 'Fira Code', var(--font-brand);
      font-size: var(--text-sm);
      letter-spacing: 0.05em;
      color: var(--accent-tech-1);
      background: var(--accent-tech-soft-bg);
      border: 1px solid var(--accent-tech-soft-border);
      border-radius: 999px;
      padding: 0.35rem 1rem;
      width: fit-content;
    }

    .roles {
      display: none;
    }

    .roles :global(.pill) {
      background: rgba(99, 102, 241, 0.08);
      border-color: rgba(99, 102, 241, 0.3);
      color: var(--gray-100);
    }

    .hero-photo {
      position: relative;
      border-radius: 1.5rem;
      padding: 3px;
      background: var(--gradient-tech);
      box-shadow: var(--shadow-md);
    }

    .hero img {
      display: block;
      width: 100%;
      aspect-ratio: 5 / 4;
      object-fit: cover;
      object-position: 75% 30%;
      border-radius: calc(1.5rem - 3px);
      background: var(--gray-999);
    }

    @media (min-width: 50em) {
      .hero {
        display: grid;
        grid-template-columns: 6fr 4fr;
        padding-inline: 2.5rem;
        gap: 3.75rem;
      }

      .hero-copy {
        align-items: flex-start;
      }

      .roles {
        margin-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .hero-photo {
        border-radius: 4.5rem;
        padding: 4px;
      }

      .hero img {
        aspect-ratio: 4 / 5;
        border-radius: calc(4.5rem - 4px);
        object-fit: cover;
      }
    }

    /* ====================================================== */

    .section {
      display: grid;
      gap: 2rem;
    }

    .with-background {
      position: relative;
    }

    .with-background::before {
      --hero-bg: var(--bg-image-subtle-2);

      content: "";
      position: absolute;
      pointer-events: none;
      left: 50%;
      width: 100vw;
      aspect-ratio: calc(2.25 / var(--bg-scale));
      top: 0;
      transform: translateY(-75%) translateX(-50%);
      background:
        url("/assets/backgrounds/noise.png") top center/220px repeat,
        var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
        var(--gray-999);
      background-blend-mode: overlay, normal, normal, normal;
      mix-blend-mode: var(--bg-blend-mode);
      z-index: -1;
    }

    .with-background.bg-variant::before {
      --hero-bg: var(--bg-image-subtle-1);
    }

    .section-header {
      justify-self: center;
      text-align: center;
      max-width: 50ch;
      font-size: var(--text-md);
      color: var(--gray-300);
    }

    .section-header h3 {
      font-size: var(--text-2xl);
    }

    @media (min-width: 50em) {
      .section {
        grid-template-columns: repeat(4, 1fr);
        grid-template-areas: "header header header header" "gallery gallery gallery gallery";
        gap: 5rem;
      }

      .section.with-cta {
        grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
      }

      .section-header {
        grid-area: header;
        font-size: var(--text-lg);
      }

      .section-header h3 {
        font-size: var(--text-4xl);
      }

      .with-cta .section-header {
        justify-self: flex-start;
        text-align: left;
      }

      .gallery {
        grid-area: gallery;
      }

      .cta {
        grid-area: cta;
      }
    }

    /* ====================================================== */

    .mention-card {
      display: flex;
      height: 7rem;
      justify-content: center;
      align-items: center;
      text-align: center;
      border: 1px solid var(--gray-800);
      border-radius: 1.5rem;
      color: var(--gray-300);
      background: var(--gradient-subtle);
      box-shadow: var(--shadow-sm);
    }
    .achievement img {
      width: 800px; /* Adjust size as needed */
      height: auto; /* Maintain aspect ratio */
      border-radius: 1rem;
      box-shadow: var(--shadow-sm);
    }
    @media (min-width: 50em) {
      .mention-card {
        border-radius: 1.5rem;
        height: 9.5rem;
      }
    }

    /* ADD these styles into your existing <style> block (or stylesheet) */

    /* container for the boxed row */
    .experience-box {
      display: flex;
      align-items: center;
      gap: 1.5rem; /* space between logo and text */
      padding: 1rem; /* inner spacing of the rectangle */
      border: 1px solid var(--gray-800);
      border-radius: 1rem;
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.01),
        rgba(0, 0, 0, 0.02)
      );
      box-shadow: var(--shadow-sm);
      max-width: 100%;
    }

    /* logo area */
    .experience-box__logo {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.25rem;
      border-radius: 0.75rem;
      background: var(--gray-999);
    }

    /* set "good size" for the logo */
    .experience-logo {
      width: 96px; /* adjust as needed */
      height: 96px;
      object-fit: contain;
      display: block;
      border-radius: 0.5rem;
    }

    /* content area grows to take remaining space */
    .experience-box__content {
      flex: 1 1 auto;
      min-width: 0; /* allow text truncation/ellipsis when needed */
    }

    /* title / company */
    .experience-title {
      margin: 0 0 0.25rem 0;
      font-size: var(--text-lg);
      line-height: 1.2;
    }

    .experience-company {
      font-weight: 500;
      color: var(--gray-400);
      margin-left: 0.5rem;
    }

    /* date and description */
    .experience-date {
      margin: 0 0 0.5rem 0;
      color: var(--gray-300);
      font-size: 0.95rem;
    }

    .experience-desc {
      margin: 0;
      color: var(--gray-300);
      font-size: 0.98rem;
    }

    .experience-more {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin: 0.75rem 0 0 0;
      color: var(--accent-tech-1);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    /* responsive tweaks: larger logo and spacing on wide screens */
    @media (min-width: 50em) {
      .experience-logo {
        width: 120px;
        height: 120px;
      }
      .experience-box {
        gap: 2rem;
        padding: 1.25rem;
      }
    }

    .experience-list {
      list-style: none; /* removes the bullet dots */
      margin: 0;
      padding: 0;
    }

    .experience-card {
      list-style: none; /* ensures no bullet for individual cards */
    }
  </style>
</BaseLayout>
